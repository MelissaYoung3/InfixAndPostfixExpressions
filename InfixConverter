#include <iostream>
#include <stack>
#include <string>
#include <sstream>
#include <cctype>
#include <stdexcept>
#include <vector>

class InfixToPostfixConverter {
private:
    std::string infix;
    std::string postfix;

    int precedence(char op) {
        if (op == '+' || op == '-') return 1;
        if (op == '*' || op == '/') return 2;
        return 0;
    }

    bool isOperator(char c) {
        return c == '+' || c == '-' || c == '*' || c == '/';
    }

public:
    InfixToPostfixConverter() {}

    InfixToPostfixConverter(const std::string& infixExpr) : infix(infixExpr) {}

    void setInfix(const std::string& expr) {
        infix = expr;
    }

    std::string getPostfix() const {
        return postfix;
    }

    void convert() {
        std::stack<char> stack;
        postfix = "";
        char prev = 0;

        for (size_t i = 0; i < infix.length(); ++i) {
            char c = infix[i];

            if (std::isspace(c)) continue;

            if (std::isalnum(c)) {
                if (prev && std::isalnum(prev)) {
                    throw std::runtime_error("Missing operator between operands");
                }
                postfix += c;
                postfix += ' ';
            }
            else if (c == '(') {
                stack.push(c);
            }
            else if (c == ')') {
                while (!stack.empty() && stack.top() != '(') {
                    postfix += stack.top();
                    postfix += ' ';
                    stack.pop();
                }
                if (stack.empty()) throw std::runtime_error("Mismatched parentheses");
                stack.pop();
            }
            else if (isOperator(c)) {
                if (prev == 0 || isOperator(prev) || prev == '(') {
                    throw std::runtime_error("Invalid placement of operator");
                }
                while (!stack.empty() && precedence(stack.top()) >= precedence(c)) {
                    postfix += stack.top();
                    postfix += ' ';
                    stack.pop();
                }
                stack.push(c);
            }
            else {
                throw std::runtime_error("Invalid character in expression");
            }
            prev = c;
        }

        if (isOperator(prev)) {
            throw std::runtime_error("Expression cannot end with an operator");
        }

        while (!stack.empty()) {
            if (stack.top() == '(') throw std::runtime_error("Mismatched parentheses");
            postfix += stack.top();
            postfix += ' ';
            stack.pop();
        }
    }
};

int main() {
    std::vector<std::string> testCases = {
        "A + B",
        "A + B * C",
        "(A + B) * C",
        "A * B + C / D",
        "(A + B) * (C - D)",
        "A + B * C - D / E",
        "A * (B + C) / D",
        "(A + B * C) / (D - E)",
        "A + (B - C) * D",
        "(A + B * (C - D)) / E",
        "A + (B * C",    // Malformed - Missing parenthesis
        "A + + B"         // Malformed - Consecutive operators
    };

    for (const auto& expr : testCases) {
        try {
            InfixToPostfixConverter converter(expr);
            converter.convert();
            std::cout << "Infix: " << expr << " => Postfix: " << converter.getPostfix() << std::endl;
        } catch (const std::exception& e) {
            std::cout << "Infix: " << expr << " => Error: " << e.what() << std::endl;
        }
    }

    return 0;
}
